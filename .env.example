UDM_HOST=192.0.2.1            # IP de tu gateway/UDM (poné la tuya; no la subas a git)
UDM_USER=tu_usuario_local
UDM_PASS=tu_password

# TLS: la UDM suele tener cert self-signed. true = aceptarlo (default).
# Para verificar contra una CA propia: false + UDM_CACERT=/ruta/al/ca.pem
UDM_INSECURE_TLS=true
#UDM_CACERT=

# UF-LOCO — spoofing GPON (datos del ONT original de tu ISP)
LOCO_VENDOR_ID=XXXX
LOCO_SERIAL=XX-XX-XX-XX-XX-XX-XX-XX
LOCO_MAC_WAN=XX:XX:XX:XX:XX:XX
